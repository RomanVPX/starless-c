# Default Starless-C .scene file

# NOTES:
# - Values present here are NOT default values, they are just examples, see default_values.scene for default values
# - All boolean (bool) fields accept "true" or "false" as well as 1 or 0
# - All numeric fields accept both integer and floating point values

# Test specifications
# this settings apply when rendering with the -d option
[lofi]
# Output resolution
Resolution=1280,720
# Super Sampling Anti Aliasing level, 1 = no SSAA, 2 = 2x2 SSAA, 3 = 3x3 SSAA, etc.
SSAA=3
# Adaptive SSAA: when enabled (and SSAA > 1), renders a quick 1-sample-per-pixel pass first,
# then refines only pixels with high local luma variance using the full SSAA grid.
SSAAAdaptive=true
# Max-min luma threshold over a 3x3 neighbourhood; pixels above it are refined.
# Lower = refine more pixels (closer to full SSAA), higher = refine fewer.
SSAAThreshold=0.005
# Save a grayscale PNG mask of refined pixels to out/<scene>_ssaa_mask.png.
SSAADebugMask=true

# Integration method:
#   rk4:    classic Runge-Kutta 4 on the 3D "magic potential" ODE. The original Starless behaviour.
#   bowie:  4th-order Bowie single-step method. Much faster and more accurate near the photon sphere. Near-radial rays fall back to RK4.
Integrator=bowie
# Number of raytracing steps; extra iterations are nearly free with the Bowie integrator since escaped rays deactivate themselves.
Iterations=250
# Size of integration step for the rk4 integrator.
Stepsize=0.16
# Azimuthal step (radians) for the Bowie integrator; ignored by RK4.
Binetstepsize=0.05


# Full render options
# apply when rendering without the -d option
[hifi]
Resolution=1920,1080
SSAA=5
SSAAAdaptive=true
SSAAThreshold=0.005
SSAADebugMask=false

Integrator=bowie
Iterations=250
Stepsize=0.08
Binetstepsize=0.04

# From now on, settings apply to both tests and full renders

[geometry]

# Position of the camera in units of r_S
# x,z are the disc's plane
Cameraposition=0.0,1.0,-20.0

# Tangent of field of view
Fieldofview=1.5

# Fixes the view vector
Lookat=0.0,0.0,0.0

# The vector defining the "up" direction
# (it's actually projected on the orthogonal subspace to the view vector)
Upvector=0.2,1.0,0.0

# Disc inner/outer radii
Diskinner=2.6
Diskouter=14.0

# Enable gravitational lensing distortion (bool)
Distort=true


[materials]

# Whether to convert sRGB -> linear RGB when loading textures (bool)
sRGBIn=true
# Whether to convert back RGB -> sRGB after postprocessing, before saving (bool)
sRGBOut=true

# Whether to draw a grid on the horizon (bool)
Horizongrid=false

# Disk rendering mode
#   none:       don't draw
#   texture:    use texture adisk.jpg for both colour and alpha
#   grid:       draw blue/white checkered
#   solid:      draw solid white
#   blackbody:  use the realistic 'blackbody' model
#   <path>:     use texture <path>
Disktexture=blackbody

# -- blackbody disc options --
# these options are ignored when Disktexture != blackbody

# Redshift multiplier. Any value <= 0.0 disables redshift
Redshift=1.2

# Whether to apply disk intensity multiplier (bool)
Diskintensitydo=true
# Multiplier for impact of computed planckian brightness in disc colour brightness
Diskmultiplier=250.0

# Radial opacity falloff for blackbody disk (bool):
# When enabled, outer parts of the disk become more transparent based on relative surface brightness.
Diskopacityfalloff=false
# Exponent for radial opacity falloff. Higher = more transparent outer regions.
Diskopacityfalloffexp=2.0

# Disk structure for blackbody (no physical meaning, just for beautification and artistic effect)
# Add structure to the blackbody disk (bool):
Diskaddstructure=true
# Structure parameters (it's better to experiment with these than to try to understand the math):
# Number of "spiral arms":
Diskstructure_spiral_arms=6
# Frequency of "rings", [thin, medium, thick]
Diskstructure_rings_freq=2.0,3.0,2.0
# Pitch of "spiral":
Diskstructure_spiral_pitch=0.4
# Position variation:
Diskstructure_position_variation=0.3
# Modulation:
Diskstructure_modulation=0.12

# Sky rendering mode
#   none:       solid black
#   texture:    use texture bgedit.png
#   final:      normalized final ray direction
#   <path>:     use texture <path>
Skytexture=textures/starmap_2020_8k.png

# Ratio of sky brightness / disk brightness
Skydiskratio=1.0

# Toggle dust (bool)
Fogdo=true
# Dust intensity multiplier
Fogmult=0.025
# Fog applies every Nth ray
Fogskip=1


# --- Postprocessing options ---
# The order of these options are not important, but the following order represents the order of processing.

# 1. Gain (1.0 = no gain)
Gain=4

# 2. Whether to perform Airy disk bloom (bool)
Airy_bloom=true
# This parameter rescales the resolution (bigger = less resolution, 1.0 = standard size)
Airy_radius=0.75

# 3. Whether to perform wide gaussian (lit up dust effect) (bool)
Blurdo=true

# 4. Normalize
# -1:             don't normalize
# any positive x: make it so that x times the brightest pixel channel is sent to 1
Normalize=-1

# 5. ACES exposure multiplier (1.0 = no multiplier)
ACESExposure = 0.95
